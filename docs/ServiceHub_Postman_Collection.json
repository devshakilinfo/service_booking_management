{
  "info": {
    "name": "ServiceHub PostgreSQL API Collection",
    "description": "Collection of all REST API endpoints for ServiceHub - PostgreSQL Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Shakil Ahamed\",\n  \"email\": \"shakil@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"shakil@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Services",
      "item": [
        {
          "name": "Get All Services",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/services", "host": ["{{baseUrl}}"], "path": ["services"] }
          }
        },
        {
          "name": "Filter Services (Category)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/services?category=Cleaning",
              "host": ["{{baseUrl}}"],
              "path": ["services"],
              "query": [{ "key": "category", "value": "Cleaning" }]
            }
          }
        },
        {
          "name": "Search Services",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/services?search=repair",
              "host": ["{{baseUrl}}"],
              "path": ["services"],
              "query": [{ "key": "search", "value": "repair" }]
            }
          }
        },
        {
          "name": "Check Slot Availability",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/services/1/availability?date=2026-11-20",
              "host": ["{{baseUrl}}"],
              "path": ["services", "1", "availability"],
              "query": [{ "key": "date", "value": "2026-11-20" }]
            }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": 1,\n  \"date\": \"2026-11-20\",\n  \"timeSlot\": \"10:00 AM\",\n  \"notes\": \"Eco friendly please\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
          }
        },
        {
          "name": "Get My Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/bookings/my?type=upcoming", "host": ["{{baseUrl}}"], "path": ["bookings", "my"] }
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancellationReason\": \"Customer requested reschedule\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/bookings/1/cancel", "host": ["{{baseUrl}}"], "path": ["bookings", "1", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "AI Assistant",
      "item": [
        {
          "name": "Ask Assistant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Which service is best for home cleaning?\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/ai/ask", "host": ["{{baseUrl}}"], "path": ["ai", "ask"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" }
  ]
}
